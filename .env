# A long, secret value used to encrypt the session cookie
# generate new: openssl rand -hex 32
AUTH0_SECRET='LONG_RANDOM_VALUE'
# The base url of your application
APP_BASE_URL='https://localhost:3000'
# The url of your Auth0 tenant domain
AUTH0_DOMAIN='YOUR_AUTH0_DOMAIN.auth0.com'
# Your Auth0 application's Client ID
AUTH0_CLIENT_ID='YOUR_AUTH0_CLIENT_ID'
# Your Auth0 application's Client Secret
AUTH0_CLIENT_SECRET='YOUR_AUTH0_CLIENT_SECRET'
# The base url of the API endpoints. Use https://localhost:3000 for local development
API_BASE_URL='https://localhost:3000'
# API Audience https://auth0.com/docs/get-started/architecture-scenarios/spa-api/part-2#create-the-api
API_AUDIENCE='https://my.api.com'
# API Permissions (Scope)
API_SCOPE='openid profile email'
# DISABLE EXTERNAL CALL TO API - USE MOCK DATA
DEV_API_MOCK='true'
# Spotify API integration
SPOTIFY_CLIENT_ID='client-id'
SPOTIFY_CLIENT_SECRET='client-secret'
SPOTIFY_API_URL='https://accounts.spotify.com/authorize'
SPOTIFY_AUTH_SCOPES='user scopes'