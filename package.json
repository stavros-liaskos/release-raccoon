{
  "name": "release-raccoon",
  "description": "A music release newsletter",
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' next dev --turbopack --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --fix",
    "test": "jest",
    "knip": "knip",
    "depcheck": "depcheck",
    "prettier": "prettier \"**/*\" --write",
    "all": "yarn knip && yarn depcheck && yarn prettier && yarn lint && yarn test -u"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.9.0",
    "clsx": "^2.1.1",
    "next": "^15.5.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "swr": "^2.3.6"
  },
  "engines": {
    "node": "^20.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "depcheck": "^1.4.7",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "jest-localstorage-mock": "^2.4.26",
    "knip": "^5.63.1",
    "lint-staged": "^16.1.6",
    "msw": "^2.11.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "react-test-renderer": "^19.1.1",
    "tailwindcss": "^4.1.12",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "5.9.2",
    "whatwg-fetch": "^3.6.20"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --cache --fix",
    "**/*": "prettier --write --ignore-unknown"
  },
  "resolutions": {
    "wrap-ansi": "7.0.0",
    "string-width": "4.2.3",
    "@types/react": "19.1.8"
  },
  "browserslist": [
    ">0.3%",
    "not ie 11",
    "not dead",
    "not op_mini all"
  ],
  "author": "Stavros https://stavrosliaskos.com/",
  "packageManager": "yarn@4.7.0"
}
