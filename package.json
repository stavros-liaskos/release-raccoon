    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/react-hooks": "^8.0.0",
    "@types/jest": "^29.4.2",
    "@types/node": "22.1.0",
    "@types/react": "19.1.8",
    "@typescript-eslint/eslint-plugin": "^5.26.0",
    "depcheck": "^1.4.7",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.4.5",
    "eslint-config-prettier": "^8.5.0",
